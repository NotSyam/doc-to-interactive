{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elearning-module-builder/schemas/content.json",
  "title": "E-Learning Module Content",
  "description": "Schema for the content.json that drives an e-learning module built from the shell template. Each module = course meta + brand + units (sidebar outline) + slides (one slide object per unit, with type-specific data) + glossary + narration + optional cheat-sheet/hint/resources. For per-type field docs and examples see references/slide_types.md.",
  "type": "object",
  "required": [
    "course",
    "units",
    "slides"
  ],
  "additionalProperties": false,
  "properties": {
    "course": {
      "type": "object",
      "required": [
        "code",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "Course code shown in header badge. E.g., 'PP/SOP/C1-050 REV-3'."
        },
        "title": {
          "type": "string",
          "description": "Course title shown in header #courseTitle."
        },
        "effectiveDate": {
          "type": "string",
          "description": "Effective date label, e.g., 'Berlaku: 31 Des 2024'."
        },
        "logo": {
          "type": "string",
          "description": "Path to logo image relative to module root, e.g., 'assets/logo.png'."
        },
        "logoAlt": {
          "type": "string"
        },
        "totalUnits": {
          "type": "integer",
          "minimum": 1
        },
        "passingScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 80
        },
        "totalQuestions": {
          "type": "integer",
          "minimum": 0
        },
        "devMode": {
          "type": "boolean",
          "default": true
        },
        "defaultDark": {
          "type": "boolean",
          "default": true
        },
        "enableGatingTimer": {
          "type": "boolean",
          "default": false
        },
        "webhookUrl": {
          "type": "string",
          "description": "Optional Google Apps Script webhook URL to sync quiz results and analytics to Google Sheets"
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "description": "Brand profile. Either `preset` (resolved from brand.profiles.json at build time) OR inline fields. Inline fields override preset fields.",
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "ptpp",
            "corporate",
            "education",
            "tech-startup",
            "custom"
          ]
        },
        "orgName": {
          "type": "string"
        },
        "orgDivision": {
          "type": "string"
        },
        "signatory": {
          "type": "string"
        },
        "certTitle": {
          "type": "string",
          "default": "Standard Operating Procedure"
        },
        "certRegPrefix": {
          "type": "string"
        },
        "primary": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "primaryHover": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "iceBg": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "darkBg": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "darkSurface": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "darkBorder": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "darkSubtle": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/unit"
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/slide"
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "istilah",
          "pengertian"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "istilah": {
            "type": "string"
          },
          "kategori": {
            "type": "string"
          },
          "badgeColor": {
            "type": "string"
          },
          "pengertian": {
            "type": "string"
          },
          "catatan": {
            "type": "string"
          }
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tenggatCheatSheet": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          }
        }
      }
    },
    "hintTips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "desc"
        ],
        "additionalProperties": false,
        "properties": {
          "icon": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "icon": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "unit": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "completed": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "slide": {
      "oneOf": [
        {
          "$ref": "#/definitions/cover"
        },
        {
          "$ref": "#/definitions/cardList"
        },
        {
          "$ref": "#/definitions/treeCanvas"
        },
        {
          "$ref": "#/definitions/scenarioPicker"
        },
        {
          "$ref": "#/definitions/tabbedAccordion"
        },
        {
          "$ref": "#/definitions/verificationMatrix"
        },
        {
          "$ref": "#/definitions/twoCardAccordion"
        },
        {
          "$ref": "#/definitions/docTabs"
        },
        {
          "$ref": "#/definitions/kpiDashboard"
        },
        {
          "$ref": "#/definitions/riskCards"
        },
        {
          "$ref": "#/definitions/quiz"
        },
        {
          "$ref": "#/definitions/summaryCertificate"
        },
        {
          "$ref": "#/definitions/imageGallery"
        },
        {
          "$ref": "#/definitions/videoEmbed"
        },
        {
          "$ref": "#/definitions/calloutBox"
        },
        {
          "$ref": "#/definitions/stepByStep"
        },
        {
          "$ref": "#/definitions/comparisonTable"
        },
        {
          "$ref": "#/definitions/faqAccordion"
        }
      ]
    },
    "commonSlideFields": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        }
      }
    },
    "iconCard": {
      "type": "object",
      "required": [
        "title",
        "desc"
      ],
      "additionalProperties": false,
      "properties": {
        "icon": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "description": "Optional HTML body appended after desc."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cover": {
      "type": "object",
      "required": [
        "type",
        "heroTitle"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cover"
        },
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "heroTitle": {
          "type": "string"
        },
        "heroLead": {
          "type": "string"
        },
        "heroMeta": {
          "type": "string",
          "description": "Small mono text shown above hero title, e.g., 'PP/SOP/C1-050 · REV-3 · Berlaku 31 Des 2024'."
        },
        "ctaLabel": {
          "type": "string",
          "default": "Mulai Pembelajaran"
        },
        "ctaIcon": {
          "type": "string",
          "default": "play_arrow"
        },
        "skipTo": {
          "type": "integer",
          "minimum": 0,
          "description": "Slide index the CTA button jumps to. Default 1."
        },
        "reasons": {
          "type": "array",
          "description": "Grid of icon cards (typically 4). Shown below the hero.",
          "items": {
            "$ref": "#/definitions/iconCard"
          }
        }
      }
    },
    "cardList": {
      "type": "object",
      "required": [
        "type",
        "cards"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cardList"
        },
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/iconCard"
          }
        },
        "columns": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ],
          "default": 1
        }
      }
    },
    "treeCanvas": {
      "type": "object",
      "required": [
        "type",
        "swimlaneData"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "treeCanvas"
        },
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "swimlaneData": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "section",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "section": {
                "type": "string"
              },
              "sectionIcon": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "step",
                    "title"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Stable id referenced by flowCard keys and hotspot lookups."
                    },
                    "step": {
                      "type": "string",
                      "description": "Numeric or label, e.g., '5.1' or 'KEPUTUSAN'."
                    },
                    "actor": {
                      "type": "string"
                    },
                    "actorRole": {
                      "type": "string"
                    },
                    "actorColor": {
                      "type": "string",
                      "description": "Tailwind class string for the actor badge."
                    },
                    "title": {
                      "type": "string"
                    },
                    "inputs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "outputs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "clauses": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "HTML allowed."
                    },
                    "isDecision": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "flowCard": {
          "type": "object",
          "description": "Map of stepId -> { t (title), out? (output label), branches? ([[condition, action], ...]) }.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "t"
            ],
            "properties": {
              "t": {
                "type": "string"
              },
              "out": {
                "type": "string"
              },
              "branches": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "string"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        },
        "roleFilterOptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Semua"
          ]
        },
        "phaseJumps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scenarioPicker": {
      "type": "object",
      "required": [
        "type",
        "scenarios"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "scenarioPicker"
        },
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "infoBanner": {
          "type": "string",
          "description": "HTML allowed."
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/iconCard"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "options"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "DOM-safe id used to wire verdict panel."
              },
              "label": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label",
                    "verdict"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "verdict": {
                      "type": "string",
                      "description": "HTML allowed."
                    },
                    "tone": {
                      "type": "string",
                      "enum": [
                        "positive",
                        "negative",
                        "neutral"
                      ],
                      "default": "neutral"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "tabbedAccordion": {
      "type": "object",
      "required": [
        "type",
        "tabs"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tabbedAccordion"
        },
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "t"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "t": {
                          "type": "string",
                          "description": "Item title."
                        },
                        "d": {
                          "type": "string",
                          "description": "Item description."
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "verificationMatrix": {
      "type": "object",
      "required": [
        "type",
        "tabs"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "verificationMatrix"
        },
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "defaultPic": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "doc"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "doc": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "pic": {
                      "type": "string"
                    },
                    "noInfo": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "twoCardAccordion": {
      "type": "object",
      "required": [
        "type",
        "cards"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "twoCardAccordion"
        },
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "infoBanner": {
          "type": "string"
        },
        "infoBannerIcon": {
          "type": "string",
          "default": "info"
        },
        "cards": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "title",
              "desc"
            ],
            "additionalProperties": false,
            "properties": {
              "icon": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "miniCheck": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "docTabs": {
      "type": "object",
      "required": [
        "type",
        "tabs"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "docTabs"
        },
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "itemType": {
                "type": "string",
                "enum": [
                  "list",
                  "records",
                  "attachments"
                ],
                "default": "list"
              },
              "items": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "doc"
                      ],
                      "properties": {
                        "doc": {
                          "type": "string"
                        },
                        "note": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "kpiDashboard": {
      "type": "object",
      "required": [
        "type",
        "kpis"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "kpiDashboard"
        },
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "kpis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
